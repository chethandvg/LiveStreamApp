# Azure Configuration Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control

# Azure Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=YOUR_STORAGE_ACCOUNT;AccountKey=YOUR_KEY;EndpointSuffix=core.windows.net

# Azure SignalR Configuration
AZURE_SIGNALR_CONNECTION_STRING=Endpoint=https://YOUR_SIGNALR_NAME.service.signalr.net;AccessKey=YOUR_KEY;Version=1.0;

# Azure CDN Configuration
AZURE_CDN_BASE_URL=https://YOUR_CDN_NAME.azureedge.net/livestreams

# CORS Allowed Origins (Production)
ALLOWED_ORIGIN_APPSERVICE=https://your-app-name.azurewebsites.net
ALLOWED_ORIGIN_CDN=https://your-cdn-name.azureedge.net
ALLOWED_ORIGIN_CUSTOM=https://yourdomain.com

# Application Settings
ASPNETCORE_ENVIRONMENT=Production
WEBSITES_PORT=8080
WEBSITES_ENABLE_APP_SERVICE_STORAGE=true

# Streaming Configuration (Optional - Defaults in appsettings.json)
# Streaming__MaxConcurrentStreams=50
# Streaming__MaxStreamDurationMinutes=240
# Streaming__ChunkSizeKB=512
# Streaming__SegmentDurationSeconds=2
