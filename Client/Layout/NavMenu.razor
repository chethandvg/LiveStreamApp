@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🎥 LiveStream App</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="broadcast">
                <span class="bi bi-broadcast" aria-hidden="true"></span> Go Live
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <a class="nav-link" href="#" @onclick="NavigateToRandomStream" @onclick:preventDefault>
                <span class="bi bi-tv" aria-hidden="true"></span> Watch Stream
            </a>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="bi bi-info-circle-fill" aria-hidden="true"></span> About
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="diagnostics">
                <span class="bi bi-clipboard-data" aria-hidden="true"></span> Diagnostics
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void NavigateToRandomStream()
    {
        // For demo, navigate to a sample stream ID
        // In production, you'd fetch active streams from API
        var sampleStreamId = "demo-stream-001";
        Navigation.NavigateTo($"/watch/{sampleStreamId}");
    }
}