@page "/diagnostics/{StreamId?}"
@inject HttpClient Http
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Stream Diagnostics - @StreamId</PageTitle>

<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-info text-white">
            <h3><i class="bi bi-clipboard-data"></i> Stream Diagnostics</h3>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label fw-bold">Stream ID</label>
                <div class="input-group">
                    <input @bind="streamIdInput" 
                           class="form-control" 
                           placeholder="Enter stream ID (e.g., stream_12345)" />
                    <button class="btn btn-primary" @onclick="RunDiagnostics">
                        <i class="bi bi-play-circle"></i> Run Diagnostics
                    </button>
                    <button class="btn btn-success" @onclick="EnableAutoRefresh" disabled="@isAutoRefresh">
                        <i class="bi bi-arrow-repeat"></i> Auto-Refresh
                    </button>
                    <button class="btn btn-secondary" @onclick="DisableAutoRefresh" disabled="@(!isAutoRefresh)">
                        <i class="bi bi-stop-circle"></i> Stop
                    </button>
                </div>
            </div>

            @if (isLoading)
            {
                <div class="text-center p-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Running diagnostics...</span>
                    </div>
                    <p class="mt-2">Running diagnostics...</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill"></i> <strong>Error:</strong> @errorMessage
                </div>
            }

            @if (diagnosticResult != null && !isLoading)
            {
                <div class="diagnostic-results">
                    <div class="alert alert-info">
                        <strong>Stream ID:</strong> @diagnosticResult.streamId<br />
                        <strong>Checked At:</strong> @diagnosticResult.timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")<br />
                        @if (isAutoRefresh)
                        {
                            <span class="badge bg-success">Auto-refreshing every @refreshInterval seconds</span>
                        }
                    </div>

                    @foreach (var check in diagnosticResult.checks)
                    {
                        var alertClass = check.status.Contains("PASS") ? "alert-success" : 
                                        check.status.Contains("FAIL") ? "alert-danger" : 
                                        check.status.Contains("WARNING") ? "alert-warning" : "alert-info";
                        
                        <div class="alert @alertClass mb-3">
                            <h5 class="alert-heading">
                                @if (check.status.Contains("PASS"))
                                {
                                    <i class="bi bi-check-circle-fill"></i>
                                }
                                else if (check.status.Contains("FAIL"))
                                {
                                    <i class="bi bi-x-circle-fill"></i>
                                }
                                else if (check.status.Contains("WARNING"))
                                {
                                    <i class="bi bi-exclamation-triangle-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-info-circle-fill"></i>
                                }
                                @check.name - <small>@check.status</small>
                            </h5>
                            <p class="mb-0">@check.message</p>
                            
                            @if (check.details != null)
                            {
                                <hr />
                                <small>
                                    <strong>Details:</strong>
                                    <pre class="bg-light p-2 rounded mt-2">@System.Text.Json.JsonSerializer.Serialize(check.details, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
                                </small>
                            }
                            
                            @if (!string.IsNullOrEmpty(check.error))
                            {
                                <hr />
                                <small class="text-danger">
                                    <strong>Error:</strong> @check.error
                                </small>
                            }
                        </div>
                    }

                    <div class="alert alert-light">
                        <strong>Quick Actions:</strong>
                        <div class="mt-2">
                            <a href="/broadcast" class="btn btn-sm btn-danger me-2">
                                <i class="bi bi-broadcast"></i> Go to Broadcaster
                            </a>
                            <a href="/watch/@streamIdInput" class="btn btn-sm btn-primary me-2">
                                <i class="bi bi-play-circle"></i> Watch Stream
                            </a>
                            <button class="btn btn-sm btn-secondary" @onclick="CopyStreamUrl">
                                <i class="bi bi-clipboard"></i> Copy Stream URL
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card mt-3">
        <div class="card-header bg-secondary text-white">
            <h5><i class="bi bi-info-circle"></i> Troubleshooting Tips</h5>
        </div>
        <div class="card-body">
            <h6>Common Issues:</h6>
            <ul>
                <li><strong>"Stream not found":</strong> Broadcaster hasn't started streaming yet. Start at /broadcast first.</li>
                <li><strong>"Azure Storage not configured":</strong> Set connection string in Server/appsettings.json</li>
                <li><strong>"Manifest file not found":</strong> Wait 10 seconds after starting for FFmpeg to create files</li>
                <li><strong>"No video segments":</strong> FFmpeg might be having issues. Check server logs.</li>
            </ul>
            
            <h6 class="mt-3">Expected Timeline:</h6>
            <ol>
                <li>Broadcaster clicks "Start Broadcasting" (instant)</li>
                <li>Server receives first chunk (~1 second)</li>
                <li>FFmpeg creates index.m3u8 (~5 seconds)</li>
                <li>First segment uploaded to Azure (~7 seconds)</li>
                <li>Viewer can play stream (~10 seconds total)</li>
            </ol>

            <h6 class="mt-3">PowerShell Diagnostic Script:</h6>
            <pre class="bg-dark text-light p-2 rounded">.\diagnose-stream.ps1 -StreamId "@streamIdInput"</pre>
        </div>
    </div>
</div>

<style>
    .diagnostic-results {
        animation: fadeIn 0.3s;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    pre {
        max-height: 300px;
        overflow-y: auto;
    }
</style>

@code {
    [Parameter]
    public string? StreamId { get; set; }

    private string streamIdInput = string.Empty;
    private bool isLoading = false;
    private bool isAutoRefresh = false;
    private string errorMessage = string.Empty;
    private DiagnosticResult? diagnosticResult;
    private System.Threading.Timer? refreshTimer;
    private int refreshInterval = 5;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrEmpty(StreamId))
        {
            streamIdInput = StreamId;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(StreamId))
        {
            await RunDiagnostics();
        }
    }

    private async Task RunDiagnostics()
    {
        if (string.IsNullOrWhiteSpace(streamIdInput))
        {
            errorMessage = "Please enter a stream ID";
            return;
        }

        isLoading = true;
        errorMessage = string.Empty;
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync($"api/streamingest/diagnose/{streamIdInput}");
            if (response.IsSuccessStatusCode)
            {
                diagnosticResult = await response.Content.ReadFromJsonAsync<DiagnosticResult>();
                errorMessage = string.Empty;
            }
            else
            {
                errorMessage = $"Failed to retrieve diagnostics: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error running diagnostics: {ex.Message}";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private void EnableAutoRefresh()
    {
        isAutoRefresh = true;
        refreshTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                await RunDiagnostics();
            });
        }, null, TimeSpan.FromSeconds(refreshInterval), TimeSpan.FromSeconds(refreshInterval));
        StateHasChanged();
    }

    private void DisableAutoRefresh()
    {
        isAutoRefresh = false;
        refreshTimer?.Dispose();
        refreshTimer = null;
        StateHasChanged();
    }

    private async Task CopyStreamUrl()
    {
        var streamUrl = $"{Navigation.BaseUri}watch/{streamIdInput}";
        // This would require JS interop in a real implementation
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        refreshTimer?.Dispose();
    }

    private class DiagnosticResult
    {
        public string streamId { get; set; } = string.Empty;
        public DateTime timestamp { get; set; }
        public List<DiagnosticCheck> checks { get; set; } = new();
    }

    private class DiagnosticCheck
    {
        public string name { get; set; } = string.Empty;
        public string status { get; set; } = string.Empty;
        public string message { get; set; } = string.Empty;
        public object? details { get; set; }
        public string? error { get; set; }
    }
}
